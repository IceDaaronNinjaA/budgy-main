rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // All new financial data is stored under the user's UID.
      match /{document=**} {
        allow read: if isOwner(uid);

        // Financial writes must go through our trusted backend.
        // Client applications cannot directly modify financial data.
        allow write: if false;
      }

      // Categories are labels, not financial postings. Allow an owner to
      // create one directly from the app with a constrained, safe shape.
      match /categories/{categoryId} {
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'categoryId', 'name', 'type', 'archived', 'schemaVersion',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.categoryId == categoryId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.archived == false
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update, delete: if false;
      }

      // Spark-plan client transaction path. These records are owner-scoped;
      // balances are derived client-side from active transaction records.
      match /transactions/{transactionId} {
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'requestId', 'eventType', 'amountCents', 'effectiveDate',
            'sourceKey', 'categoryId', 'description', 'schemaVersion',
            'status', 'createdAt'
          ])
          && request.resource.data.requestId is string
          && request.resource.data.requestId.size() > 0
          && request.resource.data.requestId.size() <= 110
          && request.resource.data.eventType in ['income', 'expense']
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.effectiveDate is string
          && request.resource.data.effectiveDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && ((request.resource.data.eventType == 'expense'
            && request.resource.data.sourceKey == 'unallocated')
            || (request.resource.data.eventType == 'income'
            && request.resource.data.sourceKey == null))
          && (request.resource.data.categoryId == null
            || (request.resource.data.categoryId is string
              && request.resource.data.categoryId.size() > 0
              && request.resource.data.categoryId.size() <= 128))
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 200
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time;
        allow read: if isOwner(uid);
        allow update, delete: if false;
      }

      // Spark-compatible goal metadata path. Goal creation does not move
      // money; reserve transfers and journal mutations remain backend-only.
      match /savingsGoals/{goalId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'goalId', 'name', 'description', 'targetCents', 'startDate',
            'deadlineDate', 'initialReservedCents', 'status', 'paused',
            'archived', 'currentReservedCents', 'lastOperationId',
            'schemaVersion', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.goalId == goalId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (!request.resource.data.keys().hasAny(['description'])
            || (request.resource.data.description is string
              && request.resource.data.description.size() <= 240))
          && request.resource.data.targetCents is int
          && request.resource.data.targetCents > 0
          && request.resource.data.startDate is string
          && request.resource.data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.deadlineDate is string
          && request.resource.data.deadlineDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.initialReservedCents is int
          && request.resource.data.initialReservedCents == 0
          && request.resource.data.currentReservedCents is int
          && request.resource.data.currentReservedCents == 0
          && request.resource.data.lastOperationId == ''
          && request.resource.data.status == 'active'
          && request.resource.data.paused == false
          && request.resource.data.archived == false
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'targetCents', 'startDate', 'deadlineDate',
            'status', 'paused', 'archived', 'currentReservedCents', 'lastOperationId', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.targetCents is int
          && request.resource.data.targetCents > 0
          && request.resource.data.currentReservedCents is int
          && request.resource.data.currentReservedCents >= 0
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.archived == resource.data.archived
            || (request.resource.data.archived == true
              && request.resource.data.status == 'archived'
              && request.resource.data.currentReservedCents == 0))
          && (request.resource.data.currentReservedCents == resource.data.currentReservedCents
            || (request.resource.data.lastOperationId is string
              && request.resource.data.lastOperationId != resource.data.lastOperationId
              && getAfter(
                /databases/$(database)/documents/users/$(uid)/goalOperations/$(request.resource.data.lastOperationId)
              ).data.goalId == goalId
              && getAfter(
                /databases/$(database)/documents/users/$(uid)/goalOperations/$(request.resource.data.lastOperationId)
              ).data.resultingReservedCents == request.resource.data.currentReservedCents));
        allow delete: if false;
      }

      match /goalOperations/{operationId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'operationId', 'goalId', 'kind', 'amountCents',
            'resultingReservedCents', 'schemaVersion', 'createdAt'
          ])
          && request.resource.data.operationId == operationId
          && request.resource.data.goalId is string
          && request.resource.data.kind in ['contribute', 'withdraw']
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.resultingReservedCents is int
          && request.resource.data.resultingReservedCents >= 0
          && request.resource.data.schemaVersion == 1
          && request.resource.data.createdAt == request.time
          && getAfter(
            /databases/$(database)/documents/users/$(uid)/savingsGoals/$(request.resource.data.goalId)
          ).data.lastOperationId == operationId
          && getAfter(
            /databases/$(database)/documents/users/$(uid)/savingsGoals/$(request.resource.data.goalId)
          ).data.currentReservedCents == request.resource.data.resultingReservedCents;
        allow update, delete: if false;
      }
    }

    // Spark-plan root collections. Each document carries its owner UID.
    match /categories/{categoryId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'categoryId', 'name', 'type', 'archived', 'schemaVersion',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.categoryId == categoryId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.archived == false
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'requestId', 'eventType', 'amountCents', 'effectiveDate',
          'sourceKey', 'categoryId', 'description', 'schemaVersion',
          'status', 'createdAt'
        ])
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() > 0
        && request.resource.data.requestId.size() <= 110
        && request.resource.data.eventType in ['income', 'expense']
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.effectiveDate is string
        && request.resource.data.effectiveDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && ((request.resource.data.eventType == 'expense'
          && request.resource.data.sourceKey == 'unallocated')
          || (request.resource.data.eventType == 'income'
          && request.resource.data.sourceKey == null))
        && (request.resource.data.categoryId == null
          || (request.resource.data.categoryId is string
            && request.resource.data.categoryId.size() > 0
            && request.resource.data.categoryId.size() <= 128))
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 200
        && request.resource.data.schemaVersion == 1
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Everything else, including legacy top-level collections,
    // is inaccessible to client applications.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
